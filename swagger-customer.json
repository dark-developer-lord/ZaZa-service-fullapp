{
  "openapi": "3.0.3",
  "info": {
    "title": "ZaZa Customer App API",
    "version": "2.1.0",
    "description": "Customer authentication endpoints after migration to phone+OTP flow (v1 and v3), including legacy compatibility endpoints."
  },
  "servers": [
    { "url": "http://localhost:8000/api/v1", "description": "Development v1" },
    { "url": "https://api.zaza.tj/api/v1", "description": "Production v1" },
    { "url": "http://localhost:8000/api/v3", "description": "Development v3" },
    { "url": "https://api.zaza.tj/api/v3", "description": "Production v3" }
  ],
  "tags": [
    { "name": "Customer Auth v1" },
    { "name": "Customer Auth v3" },
    { "name": "Customer Auth Legacy" }
  ],
  "components": {
    "schemas": {
      "PhoneRequest": {
        "type": "object",
        "required": ["phone"],
        "properties": {
          "phone": {
            "type": "string",
            "example": "+992901234567",
            "minLength": 7,
            "maxLength": 20
          }
        }
      },
      "OtpVerifyRequest": {
        "type": "object",
        "required": ["phone", "otp"],
        "properties": {
          "phone": {
            "type": "string",
            "example": "+992901234567",
            "minLength": 7,
            "maxLength": 20
          },
          "otp": {
            "type": "string",
            "example": "123456",
            "minLength": 4,
            "maxLength": 6
          }
        }
      },
      "V1OtpSentResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "OTP sent successfully" },
          "is_phone_verified": { "type": "integer", "example": 0 },
          "phone_verify_end_url": { "type": "string", "example": "api/v1/auth/verify-phone" },
          "otp": { "type": "integer", "example": 123456 }
        }
      },
      "V1AuthResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Phone number verified successfully" },
          "token": { "type": "string" },
          "is_phone_verified": { "type": "integer", "example": 1 },
          "user": {
            "type": "object",
            "properties": {
              "id": { "type": "integer", "example": 11 },
              "f_name": { "type": "string", "example": "User" },
              "l_name": { "type": "string", "example": "+992901234567" },
              "phone": { "type": "string", "example": "+992901234567" },
              "email": { "type": "string", "example": "+992901234567@placeholder.zaza" },
              "status": { "type": "integer", "example": 1 },
              "is_phone_verified": { "type": "integer", "example": 1 }
            }
          }
        }
      },
      "V3OtpSentResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "OTP sent successfully" },
          "phone": { "type": "string", "example": "+992901234567" },
          "otp": { "type": "integer", "example": 1234 }
        }
      },
      "V3AuthResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "message": { "type": "string", "example": "Авторизация выполнена успешно" },
          "user": {
            "type": "object",
            "properties": {
              "id": { "type": "integer", "example": 11 },
              "f_name": { "type": "string", "example": "User" },
              "l_name": { "type": "string", "example": "+992901234567" },
              "phone": { "type": "string", "example": "+992901234567" },
              "email": { "type": "string", "example": "+992901234567@placeholder.zaza" },
              "status": { "type": "integer", "example": 1 },
              "is_phone_verified": { "type": "integer", "example": 1 }
            }
          }
        }
      },
      "LegacySendOtpRequest": {
        "type": "object",
        "required": ["phone"],
        "properties": {
          "phone": { "type": "string", "example": "+992901234567" }
        }
      },
      "LegacyVerifyOtpRequest": {
        "type": "object",
        "required": ["phone", "otp"],
        "properties": {
          "phone": { "type": "string", "example": "+992901234567" },
          "otp": { "type": "string", "example": "123456", "minLength": 6, "maxLength": 6 }
        }
      },
      "LegacyAuthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean", "example": true },
          "token": { "type": "string" },
          "user": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string" },
              "phone": { "type": "string" },
              "email": { "type": "string" },
              "image": { "type": "string" },
              "wallet": { "type": "number" }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean", "nullable": true },
          "message": { "type": "string" },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/sign-up": {
      "post": {
        "tags": ["Customer Auth v1"],
        "summary": "Request OTP for customer sign-up (phone only)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PhoneRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP requested",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/V1OtpSentResponse" }
              }
            }
          },
          "403": {
            "description": "Blocked account or validation issue",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "405": {
            "description": "Failed to send OTP",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Customer Auth v1"],
        "summary": "Request OTP for customer login (phone only)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PhoneRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP requested",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/V1OtpSentResponse" }
              }
            }
          },
          "403": {
            "description": "Blocked account or validation issue",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "405": {
            "description": "Failed to send OTP",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/verify-phone": {
      "post": {
        "tags": ["Customer Auth v1"],
        "summary": "Verify OTP and complete login (v1)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OtpVerifyRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/V1AuthResponse" }
              }
            }
          },
          "403": {
            "description": "Blocked account",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "User not found or OTP mismatch",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/register": {
      "post": {
        "servers": [
          { "url": "http://localhost:8000/api/v3", "description": "Development v3" },
          { "url": "https://api.zaza.tj/api/v3", "description": "Production v3" }
        ],
        "tags": ["Customer Auth v3"],
        "summary": "Request OTP for customer registration (v3)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PhoneRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP requested",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/V3OtpSentResponse" }
              }
            }
          },
          "403": {
            "description": "Blocked account",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "servers": [
          { "url": "http://localhost:8000/api/v3", "description": "Development v3" },
          { "url": "https://api.zaza.tj/api/v3", "description": "Production v3" }
        ],
        "tags": ["Customer Auth v3"],
        "summary": "Request OTP for customer login (v3)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PhoneRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP requested",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/V3OtpSentResponse" }
              }
            }
          },
          "403": {
            "description": "Blocked account",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/verify-phone": {
      "post": {
        "servers": [
          { "url": "http://localhost:8000/api/v3", "description": "Development v3" },
          { "url": "https://api.zaza.tj/api/v3", "description": "Production v3" }
        ],
        "tags": ["Customer Auth v3"],
        "summary": "Verify OTP and complete login (v3)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OtpVerifyRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/V3AuthResponse" }
              }
            }
          },
          "401": {
            "description": "Invalid or expired OTP",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "403": {
            "description": "Blocked account",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/customer/send-otp": {
      "post": {
        "tags": ["Customer Auth Legacy"],
        "summary": "Legacy OTP send endpoint used by older clients",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LegacySendOtpRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "OTP sent" },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/customer/verify-otp": {
      "post": {
        "tags": ["Customer Auth Legacy"],
        "summary": "Legacy OTP verify endpoint used by older clients",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LegacyVerifyOtpRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LegacyAuthResponse" }
              }
            }
          },
          "401": {
            "description": "Invalid or expired OTP",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Account not found or disabled",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  }
}
