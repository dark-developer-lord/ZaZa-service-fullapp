{
  "openapi": "3.0.3",
  "info": {
    "title": "ZaZa Service API",
    "version": "2.1.0",
    "description": "Unified API document for endpoints currently used by Customer, Driver, and Restaurant frontend applications, including new phone+OTP customer auth flow."
  },
  "servers": [
    { "url": "http://localhost:8000/api/v1", "description": "Development" },
    { "url": "https://api.zaza.tj/api/v1", "description": "Production" },
    { "url": "http://localhost:8000/api/v3", "description": "Development v3" },
    { "url": "https://api.zaza.tj/api/v3", "description": "Production v3" }
  ],
  "tags": [
    { "name": "Customer Auth v1" },
    { "name": "Customer Auth v3" },
    { "name": "Customer Auth Legacy" },
    { "name": "Driver Auth" },
    { "name": "Driver Profile" },
    { "name": "Driver Orders" },
    { "name": "Driver Wallet" },
    { "name": "Partner Request" }
  ],
  "components": {
    "securitySchemes": {
      "QueryToken": { "type": "apiKey", "in": "query", "name": "token" },
      "BearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "Token" }
    }
  },
  "paths": {
    "/auth/customer/send-otp": {
      "post": {
        "tags": ["Customer Auth Legacy"],
        "summary": "Legacy endpoint: send OTP to customer phone",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone"],
                "properties": {
                  "phone": {
                    "type": "string",
                    "minLength": 7,
                    "maxLength": 20,
                    "example": "+992901234567"
                  }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "OTP sent" }, "422": { "description": "Validation failed" } }
      }
    },
    "/auth/customer/verify-otp": {
      "post": {
        "tags": ["Customer Auth Legacy"],
        "summary": "Legacy endpoint: verify customer OTP",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone", "otp"],
                "properties": {
                  "phone": { "type": "string", "example": "+992901234567" },
                  "otp": { "type": "string", "minLength": 6, "maxLength": 6, "example": "123456" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token and user returned" },
          "401": { "description": "Invalid OTP" },
          "404": { "description": "Account not found or disabled" }
        }
      }
    },
    "/auth/sign-up": {
      "post": {
        "tags": ["Customer Auth v1"],
        "summary": "v1 sign-up: request OTP by phone",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone"],
                "properties": {
                  "phone": {
                    "type": "string",
                    "minLength": 7,
                    "maxLength": 20,
                    "example": "+992901234567"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OTP requested" },
          "403": { "description": "Blocked account or validation error" },
          "405": { "description": "OTP delivery failed" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Customer Auth v1"],
        "summary": "v1 login: request OTP by phone",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone"],
                "properties": {
                  "phone": {
                    "type": "string",
                    "minLength": 7,
                    "maxLength": 20,
                    "example": "+992901234567"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OTP requested" },
          "403": { "description": "Blocked account or validation error" },
          "405": { "description": "OTP delivery failed" }
        }
      }
    },
    "/auth/verify-phone": {
      "post": {
        "tags": ["Customer Auth v1"],
        "summary": "v1 verify phone OTP and complete login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone", "otp"],
                "properties": {
                  "phone": {
                    "type": "string",
                    "example": "+992901234567"
                  },
                  "otp": {
                    "type": "string",
                    "minLength": 4,
                    "maxLength": 6,
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authenticated, token returned" },
          "403": { "description": "Blocked account" },
          "404": { "description": "Not found or OTP mismatch" }
        }
      }
    },
    "/register": {
      "post": {
        "servers": [
          { "url": "http://localhost:8000/api/v3", "description": "Development v3" },
          { "url": "https://api.zaza.tj/api/v3", "description": "Production v3" }
        ],
        "tags": ["Customer Auth v3"],
        "summary": "v3 register: request OTP by phone",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone"],
                "properties": {
                  "phone": {
                    "type": "string",
                    "minLength": 7,
                    "maxLength": 20,
                    "example": "+992901234567"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OTP requested" },
          "403": { "description": "Blocked account" }
        }
      }
    },
    "/login": {
      "post": {
        "servers": [
          { "url": "http://localhost:8000/api/v3", "description": "Development v3" },
          { "url": "https://api.zaza.tj/api/v3", "description": "Production v3" }
        ],
        "tags": ["Customer Auth v3"],
        "summary": "v3 login: request OTP by phone",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone"],
                "properties": {
                  "phone": {
                    "type": "string",
                    "minLength": 7,
                    "maxLength": 20,
                    "example": "+992901234567"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OTP requested" },
          "403": { "description": "Blocked account" }
        }
      }
    },
    "/verify-phone": {
      "post": {
        "servers": [
          { "url": "http://localhost:8000/api/v3", "description": "Development v3" },
          { "url": "https://api.zaza.tj/api/v3", "description": "Production v3" }
        ],
        "tags": ["Customer Auth v3"],
        "summary": "v3 verify phone OTP and complete login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone", "otp"],
                "properties": {
                  "phone": {
                    "type": "string",
                    "example": "+992901234567"
                  },
                  "otp": {
                    "type": "string",
                    "minLength": 4,
                    "maxLength": 6,
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authenticated, token returned" },
          "401": { "description": "Invalid or expired OTP" },
          "403": { "description": "Blocked account" }
        }
      }
    },
    "/auth/delivery-man/send-otp": {
      "post": {
        "tags": ["Driver Auth"],
        "summary": "Send OTP to delivery man phone",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone"],
                "properties": { "phone": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "OTP sent" }, "404": { "description": "Delivery man not found" } }
      }
    },
    "/auth/delivery-man/verify-otp": {
      "post": {
        "tags": ["Driver Auth"],
        "summary": "Verify delivery man OTP",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone", "otp"],
                "properties": {
                  "phone": { "type": "string" },
                  "otp": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Token and driver returned" }, "401": { "description": "Invalid OTP" } }
      }
    },
    "/delivery-man/profile": {
      "get": {
        "tags": ["Driver Profile"],
        "summary": "Get delivery man profile",
        "security": [{ "QueryToken": [] }, { "BearerAuth": [] }],
        "responses": { "200": { "description": "Profile object" } }
      }
    },
    "/delivery-man/update-profile": {
      "put": {
        "tags": ["Driver Profile"],
        "summary": "Update profile",
        "security": [{ "QueryToken": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["f_name", "l_name", "email"],
                "properties": {
                  "f_name": { "type": "string" },
                  "l_name": { "type": "string" },
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Updated" } }
      }
    },
    "/delivery-man/update-fcm-token": {
      "put": {
        "tags": ["Driver Profile"],
        "summary": "Update FCM token",
        "security": [{ "QueryToken": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fcm_token"],
                "properties": { "fcm_token": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Updated" } }
      }
    },
    "/delivery-man/latest-orders": {
      "get": {
        "tags": ["Driver Orders"],
        "summary": "Get latest orders",
        "security": [{ "QueryToken": [] }, { "BearerAuth": [] }],
        "responses": { "200": { "description": "Order list" } }
      }
    },
    "/delivery-man/current-orders": {
      "get": {
        "tags": ["Driver Orders"],
        "summary": "Get current orders",
        "security": [{ "QueryToken": [] }, { "BearerAuth": [] }],
        "responses": { "200": { "description": "Order list" } }
      }
    },
    "/delivery-man/all-orders": {
      "get": {
        "tags": ["Driver Orders"],
        "summary": "Get all orders",
        "security": [{ "QueryToken": [] }, { "BearerAuth": [] }],
        "responses": { "200": { "description": "Order list" } }
      }
    },
    "/delivery-man/order-delivery-history": {
      "get": {
        "tags": ["Driver Orders"],
        "summary": "Get order-delivery history",
        "description": "Without order_id returns paginated orders; with order_id returns location history.",
        "security": [{ "QueryToken": [] }, { "BearerAuth": [] }],
        "parameters": [
          { "name": "order_id", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "offset", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "History payload" } }
      }
    },
    "/delivery-man/accept-order": {
      "put": {
        "tags": ["Driver Orders"],
        "summary": "Accept order",
        "security": [{ "QueryToken": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["order_id"],
                "properties": { "order_id": { "type": "integer" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Accepted" } }
      }
    },
    "/delivery-man/update-order-status": {
      "put": {
        "tags": ["Driver Orders"],
        "summary": "Update order status",
        "security": [{ "QueryToken": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["order_id", "status"],
                "properties": {
                  "order_id": { "type": "integer" },
                  "status": { "type": "string", "enum": ["confirmed", "canceled", "picked_up", "delivered"] },
                  "otp": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Updated" } }
      }
    },
    "/delivery-man/update-active-status": {
      "post": {
        "tags": ["Driver Profile"],
        "summary": "Toggle active status",
        "security": [{ "QueryToken": [] }, { "BearerAuth": [] }],
        "responses": { "200": { "description": "Updated" } }
      }
    },
    "/delivery-man/record-location-data": {
      "post": {
        "tags": ["Driver Orders"],
        "summary": "Record location",
        "security": [{ "QueryToken": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["latitude", "longitude"],
                "properties": {
                  "latitude": { "type": "number" },
                  "longitude": { "type": "number" },
                  "location": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Recorded" } }
      }
    },
    "/delivery-man/request-withdraw": {
      "post": {
        "tags": ["Driver Wallet"],
        "summary": "Request withdraw",
        "security": [{ "QueryToken": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount"],
                "properties": { "amount": { "type": "number", "minimum": 0.01 } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Request placed" }, "403": { "description": "Insufficient balance" } }
      }
    },
    "/partner-request/restaurant": {
      "post": {
        "tags": ["Partner Request"],
        "summary": "Submit restaurant partner request",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["merchant_name", "phone"],
                "properties": {
                  "merchant_name": { "type": "string" },
                  "contact_name": { "type": "string" },
                  "phone": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "city": { "type": "string" },
                  "address": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Created" }, "422": { "description": "Validation failed" } }
      }
    },
    "/partner-request/b2b": {
      "post": {
        "tags": ["Partner Request"],
        "summary": "Submit B2B delivery request",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["company_name", "contact_name", "phone", "email"],
                "properties": {
                  "company_name": { "type": "string" },
                  "contact_name": { "type": "string" },
                  "phone": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "city": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Created" }, "422": { "description": "Validation failed" } }
      }
    }
  }
}
