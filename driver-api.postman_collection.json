{
  "info": {
    "_postman_id": "driver-app-collection",
    "name": "ZaZa Driver App API",
    "description": "Complete API collection for ZaZa Driver Delivery App (iOS/Android Flutter)\nIncludes authentication, order management, real-time location tracking, and earnings",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"phone\": \"+992912345678\"}"
            },
            "url": {
              "raw": "{{base_url}}/driver/auth/send-otp",
              "host": ["{{base_url}}"],
              "path": ["driver", "auth", "send-otp"]
            }
          }
        },
        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('driver_token', jsonData.data.token);",
                  "    pm.test('Driver token saved', function () {",
                  "        pm.expect(jsonData.data.token).to.exist;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"phone\": \"+992912345678\", \"otp\": \"123456\"}"
            },
            "url": {
              "raw": "{{base_url}}/driver/auth/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["driver", "auth", "verify-otp"]
            }
          }
        }
      ]
    },
