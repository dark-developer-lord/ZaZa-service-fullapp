    {
      "name": "Storage Service",
      "description": "File upload to Azure, AWS S3, or Local storage",
      "item": [
        {
          "name": "Upload Restaurant Logo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{logo_file}}"
                },
                {
                  "key": "path",
                  "value": "restaurants/logos",
                  "type": "text"
                },
                {
                  "key": "disk",
                  "value": "azure",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/internal/storage/upload",
              "host": ["{{base_url}}"],
              "path": ["internal", "storage", "upload"]
            }
          }
        },
        {
          "name": "Upload Product Image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{product_image}}"
                },
                {
                  "key": "path",
                  "value": "products/images\",
                  "type": "text"
                },
                {
                  "key": "disk",
                  "value": "s3",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/internal/storage/upload",
              "host": ["{{base_url}}"],
              "path": ["internal", "storage", "upload"]
            }
          }
        }
      ]
    },
