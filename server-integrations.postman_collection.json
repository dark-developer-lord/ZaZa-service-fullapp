    {
      "name": "Email Service",
      "description": "SMTP email sending with queue support",
      "item": [
        {
          "name": "Send Order Confirmation Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{api_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"customer@example.com\",\n  \"subject\": \"Order Confirmation - Order #12345\",\n  \"template\": \"order_confirmation\",\n  \"data\": {\n    \"order_id\": \"12345\",\n    \"customer_name\": \"John Doe\",\n    \"restaurant_name\": \"Pizza Paradise\",\n    \"total_amount\": \"$25.99\",\n    \"delivery_time\": \"30 minutes\"\n  },\n  \"priority\": \"high\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/internal/email/send",
              "host": ["{{base_url}}"],
              "path": ["internal", "email", "send"]
            }
          }
        },
        {
          "name": "Send Password Reset Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{api_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"vendor@restaurant.com\",\n  \"subject\": \"Password Reset Request\",\n  \"template\": \"password_reset\",\n  \"data\": {\n    \"reset_link\": \"https://app.zaza.tj/reset-password?token=abc123xyz\",\n    \"expiry_time\": \"24 hours\"\n  },\n  \"priority\": \"high\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/internal/email/send",
              "host": ["{{base_url}}"],
              "path": ["internal", "email", "send"]
            }
          }
        },
        {
          "name": "Send Payment Receipt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{api_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"customer@example.com\",\n  \"subject\": \"Payment Receipt - Reference #PAY-2026-001\",\n  \"template\": \"payment_receipt\",\n  \"data\": {\n    \"transaction_id\": \"PAY-2026-001\",\n    \"amount\": \"$50.00\",\n    \"payment_method\": \"Razorpay\",\n    \"date\": \"2026-03-27 10:30:00\",\n    \"purpose\": \"Wallet Top-up\"\n  },\n  \"priority\": \"normal\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/internal/email/send",
              "host": ["{{base_url}}"],
              "path": ["internal", "email", "send"]
            }
          }
        }
      ]
