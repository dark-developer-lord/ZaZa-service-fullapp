{
  "info": {
    "_postman_id": "zaza-server-integrations",
    "name": "ZaZa Server-to-Server Integrations",
    "description": "Postman collection for testing backend outbound API calls to SMS, Payment, Email, Firebase, and AI services",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "SMS Services",
      "description": "OTP delivery via Nexmo and Oson SMS",
      "item": [
        {
          "name": "Send OTP - Nexmo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{api_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+992901234567\",\n  \"user_type\": \"customer\",\n  \"length\": 6\n}"
            },
            "url": {
              "raw": "{{base_url}}/internal/sms/send-otp",
              "host": ["{{base_url}}"],
              "path": ["internal", "sms", "send-otp"]
            }
          }
        },
        {
          "name": "Send OTP - Oson SMS",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{api_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+992901234567\",\n  \"user_type\": \"driver\",\n  \"length\": 4\n}"
            },
            "url": {
              "raw": "{{base_url}}/internal/sms/send-otp",
              "host": ["{{base_url}}"],
              "path": ["internal", "sms", "send-otp"]
            }
          }
        },
        {
          "name": "Verify OTP Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+992901234567\",\n  \"otp\": \"123456\",\n  \"reference\": \"{{otp_reference}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-otp"]
            }
          }
        }
      ]
    },
