{
  "info": {
    "_postman_id": "restaurant-app-collection",
    "name": "ZaZa Restaurant (Vendor) API",
    "description": "Complete API collection for ZaZa Restaurant/Vendor Web Portal (React 19 + Vite)\nIncludes vendor login, product management, order handling, and earnings tracking",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Vendor Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('vendor_token', jsonData.data.token);",
                  "    pm.test('Token saved to environment', function () {",
                  "        pm.expect(jsonData.data.token).to.exist;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"vendor@example.com\", \"password\": \"password123\"}"
            },
            "url": {
              "raw": "{{base_url}}/vendor/auth/login",
              "host": ["{{base_url}}"],
              "path": ["vendor", "auth", "login"]
            }
          }
        }
      ]
    },
