    {
      "name": "Driver App",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{driver_phone}}\"\n}" },
            "url": {
              "raw": "{{base_url}}/auth/delivery-man/send-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "delivery-man", "send-otp"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var data = pm.response.json();",
                  "  if (data.otp) pm.environment.set('driver_otp', data.otp);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{driver_phone}}\",\n  \"otp\": \"{{driver_otp}}\"\n}" },
            "url": {
              "raw": "{{base_url}}/auth/delivery-man/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "delivery-man", "verify-otp"]
