              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var data = pm.response.json();",
                  "  if (data.token) pm.environment.set('driver_token', data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{driver_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/delivery-man/profile?token={{driver_token}}",
              "host": ["{{base_url}}"],
              "path": ["delivery-man", "profile"],
              "query": [{ "key": "token", "value": "{{driver_token}}" }]
            }
          }
        },
        {
          "name": "Latest Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{driver_token}}" }
            ],
