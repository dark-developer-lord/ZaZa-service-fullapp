          }
        },
        {
          "name": "All Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{driver_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/delivery-man/all-orders?token={{driver_token}}",
              "host": ["{{base_url}}"],
              "path": ["delivery-man", "all-orders"],
              "query": [{ "key": "token", "value": "{{driver_token}}" }]
            }
          }
        },
        {
          "name": "Order Delivery History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{driver_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/delivery-man/order-delivery-history?token={{driver_token}}&limit=20&offset=1",
              "host": ["{{base_url}}"],
              "path": ["delivery-man", "order-delivery-history"],
              "query": [
                { "key": "token", "value": "{{driver_token}}" },
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "Accept Order",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{driver_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"order_id\": {{order_id}}\n}" },
            "url": {
              "raw": "{{base_url}}/delivery-man/accept-order?token={{driver_token}}",
              "host": ["{{base_url}}"],
              "path": ["delivery-man", "accept-order"],
              "query": [{ "key": "token", "value": "{{driver_token}}" }]
            }
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{driver_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"order_id\": {{order_id}},\n  \"status\": \"picked_up\"\n}" },
            "url": {
              "raw": "{{base_url}}/delivery-man/update-order-status?token={{driver_token}}",
              "host": ["{{base_url}}"],
              "path": ["delivery-man", "update-order-status"],
              "query": [{ "key": "token", "value": "{{driver_token}}" }]
            }
          }
        },
        {
          "name": "Toggle Active Status",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{driver_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{base_url}}/delivery-man/update-active-status?token={{driver_token}}",
              "host": ["{{base_url}}"],
              "path": ["delivery-man", "update-active-status"],
              "query": [{ "key": "token", "value": "{{driver_token}}" }]
            }
          }
        },
        {
          "name": "Record Location",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{driver_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 38.5598,\n  \"longitude\": 68.7870,\n  \"location\": \"Dushanbe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/delivery-man/record-location-data?token={{driver_token}}",
              "host": ["{{base_url}}"],
              "path": ["delivery-man", "record-location-data"],
              "query": [{ "key": "token", "value": "{{driver_token}}" }]
            }
          }
        },
        {
          "name": "Request Withdraw",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{driver_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 50\n}" },
            "url": {
              "raw": "{{base_url}}/delivery-man/request-withdraw?token={{driver_token}}",
              "host": ["{{base_url}}"],
              "path": ["delivery-man", "request-withdraw"],
              "query": [{ "key": "token", "value": "{{driver_token}}" }]
            }
          }
        }
      ]
    },
