      "item": [
        {
          "name": "Customer - Send OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var response = pm.response.json();",
                  "  pm.environment.set('otp_reference', response.data.reference);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+992901234567\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/customer/send-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "customer", "send-otp"]
            }
          },
          "response": []
        },
        {
          "name": "Customer - Verify OTP & Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var response = pm.response.json();",
                  "  pm.environment.set('customer_token', response.data.token);",
                  "  pm.environment.set('customer_id', response.data.user.id);",
                  "  pm.auth.setAuthHeader('Bearer ' + response.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
