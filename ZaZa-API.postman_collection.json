{
  "info": {
    "_postman_id": "zaza-unified-api-v2",
    "name": "ZaZa Service API",
    "description": "Unified Postman collection aligned with current endpoints used by all apps.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
