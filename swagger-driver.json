{
  "openapi": "3.0.0",
  "info": {
    "title": "ZaZa Driver App API",
    "version": "1.0.0",
    "description": "API documentation for ZaZa Driver Delivery App (iOS/Android Flutter)",
    "contact": {
      "name": "ZaZa Support",
      "url": "https://github.com/dark-developer-lord/ZaZa-service-fullapp"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1",
      "description": "Development Server"
    },
    {
      "url": "https://api.zaza.tj/api/v1",
      "description": "Production Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "QueryToken": {
        "type": "apiKey",
        "name": "token",
        "in": "query",
        "description": "Bearer token passed as query parameter for driver endpoints"
      }
    },
    "schemas": {
      "DriverUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "firstname": {
            "type": "string"
          },
          "lastname": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "vehicle_type": {
            "type": "string",
            "enum": ["bike", "car", "van"]
          },
          "vehicle_number": {
            "type": "string"
          },
          "rating": {
            "type": "number",
            "format": "float"
          },
          "total_deliveries": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": ["active", "inactive", "on_delivery"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DriverLocation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "driver_id": {
            "type": "integer"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "accuracy": {
            "type": "number",
            "format": "float"
          },
          "speed": {
            "type": "number",
            "format": "float"
          },
          "heading": {
            "type": "number",
            "format": "float"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DeliveryOrder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "order_number": {
            "type": "string"
          },
          "restaurant": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "address": {
                "type": "string"
              },
              "latitude": {
                "type": "number"
              },
              "longitude": {
                "type": "number"
              }
            }
          },
          "customer": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              }
            }
          },
          "delivery_address": {
            "type": "object",
            "properties": {
              "address": {
                "type": "string"
              },
              "latitude": {
                "type": "number"
              },
              "longitude": {
                "type": "number"
              }
            }
          },
          "items_count": {
            "type": "integer"
          },
          "total_amount": {
            "type": "number",
            "format": "float"
          },
          "delivery_fee": {
            "type": "number",
            "format": "float"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "accepted", "on_the_way", "delivered", "failed"]
          },
          "estimated_delivery_time": {
            "type": "integer",
            "description": "Estimated delivery time in minutes"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DriverEarnings": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "driver_id": {
            "type": "integer"
          },
          "today_earnings": {
            "type": "number",
            "format": "float"
          },
          "this_week_earnings": {
            "type": "number",
            "format": "float"
          },
          "this_month_earnings": {
            "type": "number",
            "format": "float"
          },
          "total_earnings": {
            "type": "number",
            "format": "float"
          },
          "pending_payouts": {
            "type": "number",
            "format": "float"
          },
          "completed_deliveries": {
            "type": "integer"
          },
          "cancelled_deliveries": {
            "type": "integer"
          }
        }
      }
    }
  },
  "security": [
    {
      "QueryToken": []
    }
  ],
  "paths": {
    "/driver/auth/send-otp": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Send OTP to driver phone",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string",
                    "example": "+992912345678"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/driver/auth/verify-otp": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Verify OTP and get token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string",
                    "example": "+992912345678"
                  },
                  "otp": {
                    "type": "string",
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "user": {
                          "$ref": "#/components/schemas/DriverUser"
                        },
                        "token": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/driver/profile": {
      "get": {
        "tags": ["Driver Profile"],
        "summary": "Get driver profile",
        "responses": {
          "200": {
            "description": "Driver profile retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/DriverUser"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Driver Profile"],
        "summary": "Update driver profile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstname": {
                    "type": "string"
                  },
                  "lastname": {
                    "type": "string"
                  },
                  "vehicle_type": {
                    "type": "string",
                    "enum": ["bike", "car", "van"]
                  },
                  "vehicle_number": {
                    "type": "string"
                  },
                  "image": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/DriverUser"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/driver/location": {
      "post": {
        "tags": ["Location Tracking"],
        "summary": "Update driver location",
        "description": "Update real-time driver location for order tracking and dispatch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "latitude": {
                    "type": "number",
                    "example": 38.5598
                  },
                  "longitude": {
                    "type": "number",
                    "example": 68.7738
                  },
                  "accuracy": {
                    "type": "number",
                    "example": 5.5
                  },
                  "speed": {
                    "type": "number",
                    "example": 20.5
                  },
                  "heading": {
                    "type": "number",
                    "example": 45.0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Location updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/DriverLocation"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["Location Tracking"],
        "summary": "Get driver current location",
        "responses": {
          "200": {
            "description": "Location retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/DriverLocation"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/driver/orders/available": {
      "get": {
        "tags": ["Orders"],
        "summary": "Get available delivery orders",
        "description": "Fetch list of pending orders available for delivery",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "latitude",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "longitude",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "radius",
            "in": "query",
            "schema": {
              "type": "integer",
              "description": "Search radius in kilometers"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Available orders retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DeliveryOrder"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/driver/orders/active": {
      "get": {
        "tags": ["Orders"],
        "summary": "Get active delivery orders",
        "description": "Get list of orders driver is currently delivering",
        "responses": {
          "200": {
            "description": "Active orders retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DeliveryOrder"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/driver/orders/{id}/accept": {
      "post": {
        "tags": ["Orders"],
        "summary": "Accept delivery order",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order accepted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/DeliveryOrder"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/driver/orders/{id}/status": {
      "put": {
        "tags": ["Orders"],
        "summary": "Update order delivery status",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["on_the_way", "delivered", "failed"],
                    "example": "on_the_way"
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/DeliveryOrder"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/driver/orders/{id}/complete": {
      "post": {
        "tags": ["Orders"],
        "summary": "Mark order as delivered",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "latitude": {
                    "type": "number"
                  },
                  "longitude": {
                    "type": "number"
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Proof of delivery photo"
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order marked as delivered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/DeliveryOrder"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/driver/earnings": {
      "get": {
        "tags": ["Earnings"],
        "summary": "Get driver earnings",
        "description": "Retrieve earnings summary and detailed breakdown",
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["today", "week", "month", "all"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Earnings retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/DriverEarnings"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/driver/earnings/history": {
      "get": {
        "tags": ["Earnings"],
        "summary": "Get earnings history",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "from_date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to_date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Earnings history retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "order_id": {
                            "type": "integer"
                          },
                          "amount": {
                            "type": "number"
                          },
                          "date": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/driver/earnings/withdraw": {
      "post": {
        "tags": ["Earnings"],
        "summary": "Request earnings withdrawal",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "number",
                    "example": 100.00
                  },
                  "bank_account": {
                    "type": "string"
                  },
                  "payment_method": {
                    "type": "string",
                    "enum": ["bank_transfer", "mobile_money"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Withdrawal request submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/driver/ratings": {
      "get": {
        "tags": ["Ratings"],
        "summary": "Get driver ratings",
        "responses": {
          "200": {
            "description": "Ratings retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "average_rating": {
                          "type": "number",
                          "format": "float"
                        },
                        "total_reviews": {
                          "type": "integer"
                        },
                        "reviews": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "customer_name": {
                                "type": "string"
                              },
                              "rating": {
                                "type": "number"
                              },
                              "comment": {
                                "type": "string"
                              },
                              "created_at": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/driver/status": {
      "put": {
        "tags": ["Status"],
        "summary": "Update driver availability status",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["active", "inactive", "break"],
                    "example": "active"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
